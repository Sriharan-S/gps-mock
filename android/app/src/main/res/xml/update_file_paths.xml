<?xml version="1.0" encoding="utf-8"?>
<!-- Locations the FileProvider may share. Downloaded update APKs live in the
     app's internal files directory, which is where path_provider's
     getApplicationSupportDirectory() points on Android. -->
<paths>
    <files-path name="internal_files" path="." />
    <cache-path name="internal_cache" path="." />
    <external-files-path name="external_files" path="." />
</paths>
